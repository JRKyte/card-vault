# Supabase project URL and publishable key (see README). Public by design; RLS protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: a free key from https://dev.pokemontcg.io raises the rate limit.
VITE_POKEMONTCG_API_KEY=
